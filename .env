# ==========================================
# CryptoPulse - Configuración de Entorno
# ==========================================

# 1. Base de Datos Relacional: PostgreSQL 16 (Portfolio Service - E2)
# Propósito: Usuarios, Wallets individuales (no compartidas), Transacciones y Simulaciones
POSTGRES_USER=cryptopulse
POSTGRES_PASSWORD=cryptopulse_secret_2024
POSTGRES_DB=cryptopulse_portfolio
PORTFOLIO_DATABASE_URL=postgresql+asyncpg://cryptopulse:cryptopulse_secret_2024@postgres:5432/cryptopulse_portfolio
DATABASE_URL=postgresql+asyncpg://cryptopulse:cryptopulse_secret_2024@postgres:5432/cryptopulse_portfolio

# 2. Base de Datos Documental: MongoDB 7 (Market Service - E1)
# Propósito: Ingesta rápida de cotizaciones, registros de cambios de criptomonedas e histórico de mercado
MONGO_INITDB_ROOT_USERNAME=cryptopulse
MONGO_INITDB_ROOT_PASSWORD=cryptopulse_secret_2024
MONGO_DB=cryptopulse_market
MONGO_URI=mongodb://cryptopulse:cryptopulse_secret_2024@mongodb:27017/cryptopulse_market?authSource=admin

# 3. Base de Datos en Memoria: Redis 7 (Notification Worker - E3)
# Propósito: Colas de alertas, procesamiento de notificaciones asíncronas y caché de latencia ultra-baja
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# APIs Financieras Externas
COINGECKO_API_URL=https://api.coingecko.com/api/v3
FRANKFURTER_API_URL=https://api.frankfurter.app
FALLBACK_FOREX_URL=https://open.er-api.com/v6/latest

# Puertos y Enlaces de Red Interna (cryptopulse-internal)
MARKET_SERVICE_PORT=8000
PORTFOLIO_SERVICE_PORT=8001
NOTIFICATION_WORKER_PORT=8002
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# URLs para Comunicación Inter-Servicios (REST APIs)
INTERNAL_MARKET_SERVICE_URL=http://market-service:8000
INTERNAL_PORTFOLIO_SERVICE_URL=http://portfolio-service:8001
INTERNAL_NOTIFICATION_WORKER_URL=http://notification-worker:8002

