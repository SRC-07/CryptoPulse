# ============================================
# CryptoPulse - Environment Variables
# ============================================

# PostgreSQL Configuration
POSTGRES_USER=cryptopulse
POSTGRES_PASSWORD=cryptopulse_secret_2024
POSTGRES_DB=cryptopulse_db

# Database URL for FastAPI (internal Docker network)
DATABASE_URL=postgresql+asyncpg://cryptopulse:cryptopulse_secret_2024@postgres:5432/cryptopulse_db

# External API URLs (public, no API keys required)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
FRANKFURTER_API_URL=https://api.frankfurter.app

# Service Configuration
MARKET_SERVICE_PORT=8000
GATEWAY_PORT=8080
FRONTEND_PORT=3000
