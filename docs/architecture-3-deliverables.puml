@startuml CryptoPulse_3_Entregas
!theme plain
skinparam backgroundColor #0F141C
skinparam defaultFontColor #E2E8F0
skinparam shadowing false
skinparam roundcorner 12
skinparam packageBackgroundColor #161E2E
skinparam packageBorderColor #334155
skinparam componentBackgroundColor #1E293B
skinparam componentBorderColor #00E5A3
skinparam databaseBackgroundColor #1E293B
skinparam databaseBorderColor #3B82F6
skinparam arrowColor #00E5A3

title CryptoPulse - Arquitectura Distribuida (Hoja de Ruta 3 Entregas)

package "Capa de Cliente (Publica)" {
  [Frontend Web React 18 SPA\n(Puerto 3000 / Nginx)] as FE
}

package "Perimetro de Entrada Seguro" {
  [API Gateway Nginx 1.27\n(Puerto 8080: Reverse Proxy / Load Balancer)] as GW
}

package "Red Privada Docker (cryptopulse-internal)" {

  package "Fase 1: Entregable 1 (Completado)" #0B1E2E {
    [Market Service #1\n(FastAPI / Python 3.12)] as MS1
    database "Db1: PostgreSQL 16\n(Relacional ACID - Precios/Historial)" as DB_PG
  }

  package "Fase 2: Entregable 2 (Persistencia Poliglota)" #171E2E {
    [Market Service #2\n(FastAPI Replica)] as MS2
    [Portfolio Service\n(FastAPI / JWT Auth)] as PS
    database "Db2: MongoDB 7.0\n(Documental BSON - Usuarios/Portafolios)" as DB_MGO
  }

  package "Fase 3: Entregable 3 (Resiliencia y Eventos)" #1C1E26 {
    [Notification Worker\n(Async Consumer)] as NW
    database "Db3: Redis 7 In-Memory\n(Cache TTL 30s & Pub/Sub)" as DB_RDS
  }
}

cloud "APIs Financieras Externas" {
  [CoinGecko API v3] as API_CG
  [Frankfurter / Open-ER-API] as API_FX
}

FE --> GW : HTTP / REST (8080)
GW --> MS1 : Proxy / Round-Robin
GW --> MS2 : Load Balancing (E2)
GW --> PS : Auth & Portfolios (E2)

MS1 --> DB_PG : Asyncpg / SQLAlchemy
MS1 --> API_CG : Precios Cripto
MS1 --> API_FX : Tasas Forex (COP/USD/EUR)
MS2 --> DB_PG : Lectura

PS --> DB_MGO : Motor Driver (BSON)
MS1 ..> DB_RDS : Cache-Aside (E3)
MS1 ..> DB_RDS : Pub Eventos (E3)
NW ..> DB_RDS : Sub Eventos (E3)

@enduml
